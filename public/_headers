# Cloudflare Pages response headers.
#
# Every matching rule applies; the most specific one wins on a conflict.

# ---------------------------------------------------------------------------
# Security - applies to every response
# ---------------------------------------------------------------------------
/*
  # Cloudflare serves this site over HTTPS only, so a year is safe for the apex.
  # Deliberately narrow: "includeSubDomains" would force HTTPS on every
  # subdomain for a year in any browser that has visited here, and "preload"
  # is effectively permanent. Both are the domain owner's call once the full
  # subdomain list is known to be HTTPS-only - add them then, not from a build.
  Strict-Transport-Security: max-age=31536000
  # frame-ancestors is the current control; X-Frame-Options stays for old browsers.
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # This site asks for none of these. Denying them means a compromised or
  # injected script cannot ask on our behalf.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# ---------------------------------------------------------------------------
# Hashed build output - filename changes on every content change, so it can be
# cached permanently. "immutable" stops revalidation requests on reload.
# ---------------------------------------------------------------------------
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Content-Type: text/css

/assets/*.js
  Content-Type: application/javascript

/assets/*.svg
  Content-Type: image/svg+xml

/assets/*.woff2
  Content-Type: font/woff2

/assets/*.woff
  Content-Type: font/woff

# ---------------------------------------------------------------------------
# Unhashed static files. Long-lived but revalidatable, because replacing one
# keeps its URL - a year of immutable caching would strand old copies.
# ---------------------------------------------------------------------------
/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.ico
  Content-Type: image/x-icon
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

/manifest.json
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

# ---------------------------------------------------------------------------
# Crawler-facing files change on deploy and must not be served stale.
# ---------------------------------------------------------------------------
/sitemap.xml
  Content-Type: application/xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

# ---------------------------------------------------------------------------
# HTML is the SPA shell. Never cache it: a stale shell references asset
# filenames that no longer exist after a deploy, and the page fails to boot.
# ---------------------------------------------------------------------------
/*.html
  Content-Type: text/html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate
